# The generator's own ignore rules. Released to keely-app as its root
# .gitignore by scripts/release.sh, so keep it to what the generator needs.

# Build output
dist/

# Astro's generated types and dev cache
.astro/

# Dependencies
node_modules/

# Computed from the vault by `npm run index`, never authored (D-148):
# the entity index and relationships, and copies of scene images.
.keely-cache/
public/scenes/

# The app's safety net for an author's work (D-165). Also what a vault's own
# git should ignore; it's plain copies of files already in the vault.
Keely History/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.production

# macOS
.DS_Store
