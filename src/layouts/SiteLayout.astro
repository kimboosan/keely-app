---
import { BASE, url } from '../utils/url.js';
import { getPublisherConfig } from '../utils/config.js';
import PreviewMode from '../components/PreviewMode.astro';
import { getImage } from 'astro:assets';
import { publisherLogo } from '../utils/publisherLogo.mjs';

const publisher = getPublisherConfig();
const dataImages = import.meta.glob('@vault/data/**/*.{jpg,png,webp,gif,svg}', { eager: true });
const logo = publisherLogo(publisher.logo, dataImages);
// The header shows the logo 40px tall (reader.css); the copy made here is
// twice that, so it stays sharp on high-resolution screens. The author's
// original file is left as it is.
const logoUrl = logo?.image ? (await getImage({ src: logo.image, height: 80 })).src : (logo?.url ? url(logo.url) : null);

// `crumbs`: the page's breadcrumb trail (D-177), from utils/crumbs.js.
const {
  title,
  crumbs = [],
  showNavToggle = false,
  showWikiToggle = false,
  sidebarCollapsed = false,
} = Astro.props;
---

<html data-sidebar-collapsed={sidebarCollapsed} data-base={BASE || undefined}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    {/* D-173: the author asked search engines not to list the site. */}
    {publisher.hide_from_search_engines === true && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href={url('/styles/reader.css')} />
    <script is:inline src={url('/scripts/reader-prefs.js')}></script>
    {import.meta.env.DEV && <PreviewMode />}
  </head>
  <body class="site-layout">
    <header id="site-header">
      <nav id="header-left" aria-label="Breadcrumb">
        {crumbs.length > 0 && (
          <ol class="crumbs">
            {crumbs.map((c) => <li><a href={url(c.href)} title={c.label}>{c.label}</a></li>)}
          </ol>
        )}
      </nav>
      <div id="header-center">
        {showNavToggle && <button id="nav-toggle">Navigation</button>}
        {showWikiToggle && <button id="wiki-header-btn">Wiki</button>}
      </div>
      <div id="header-right">
        {logoUrl
          ? <a href={url('/')}><img src={logoUrl} alt={publisher.name} id="header-logo" /></a>
          : <a href={url('/')} id="header-logo">{publisher.name}</a>
        }
        <button id="reader-prefs-btn" aria-label="Reader preferences" title="Reader preferences">⚙</button>
      </div>
    </header>

    <div id="reader-prefs-modal" hidden>
      <div id="reader-prefs-panel">
        <h2>Reader Preferences</h2>
        <label>
          <input type="checkbox" id="pref-hide-warnings" />
          Hide all content warnings
        </label>
        <label>
          <input type="checkbox" id="pref-hide-notes" />
          Hide all author notes
        </label>
        <label>
          <input type="checkbox" id="pref-wiki-collapsed" />
          Collapse wiki pane by default
        </label>
        <button id="reader-prefs-close">Close</button>
      </div>
    </div>

    <slot />
  </body>
</html>