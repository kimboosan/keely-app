---
import { getPublisherConfig } from '../utils/config.js';
import PreviewMode from '../components/PreviewMode.astro';

const publisher = getPublisherConfig();

const {
  title,
  backLink = null,
  backLabel = null,
  showNavToggle = false,
  showWikiToggle = false,
  sidebarCollapsed = false,
} = Astro.props;
---

<html data-sidebar-collapsed={sidebarCollapsed}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/reader.css" />
    {import.meta.env.DEV && <PreviewMode />}
  </head>
  <body class="site-layout">
    <header id="site-header">
      <div id="header-left">
        {backLink && backLabel
          ? <a href={backLink}>← {backLabel}</a>
          : <span></span>
        }
      </div>
      <div id="header-center">
        {showNavToggle && <button id="nav-toggle">Navigation</button>}
        {showWikiToggle && <button id="wiki-header-btn">Wiki</button>}
      </div>
      <div id="header-right">
        {publisher.logo
          ? <a href="/"><img src={`/images/${publisher.logo}`} alt={publisher.name} id="header-logo" /></a>
          : <a href="/" id="header-logo">{publisher.name}</a>
        }
        <button id="reader-prefs-btn" aria-label="Reader preferences" title="Reader preferences">⚙</button>
      </div>
    </header>

    <div id="reader-prefs-modal" hidden>
      <div id="reader-prefs-panel">
        <h2>Reader Preferences</h2>
        <label>
          <input type="checkbox" id="pref-hide-warnings" />
          Hide all content warnings
        </label>
        <label>
          <input type="checkbox" id="pref-hide-notes" />
          Hide all author notes
        </label>
        <label>
          <input type="checkbox" id="pref-wiki-collapsed" />
          Collapse wiki pane by default
        </label>
        <button id="reader-prefs-close">Close</button>
      </div>
    </div>

    <slot />
  </body>
</html>