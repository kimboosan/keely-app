---
// ContentWarnings.astro
import StoryWarningsBlock from './StoryWarningsBlock.astro';
import { getWarningLabel } from '../utils/warnings.js';

const { storyWarnings, sceneWarnings, isScenePage = false } = Astro.props;

const hasStoryWarnings =
  !!storyWarnings?.required ||
  storyWarnings?.additional?.length > 0 ||
  storyWarnings?.custom?.length > 0;

const hasSceneWarnings =
  sceneWarnings?.additional?.length > 0 ||
  sceneWarnings?.custom?.length > 0;

const hasAnyWarnings = hasStoryWarnings || (isScenePage && hasSceneWarnings);
---

{hasAnyWarnings && isScenePage && (
  <div class="cw-wrapper" id="cw-wrapper">
    <button class="cw-toggle" id="cw-toggle" aria-expanded="false" aria-controls="cw-content">
      ⚠ Content warnings — <span id="cw-toggle-label">Show</span>
    </button>
    <div class="cw-content" id="cw-content" hidden>
      <StoryWarningsBlock storyWarnings={storyWarnings} />
      <div class="cw-scene">
        <span class="cw-section-label">Additionally in this scene:</span>
        {hasSceneWarnings ? (
          <Fragment>
            <div class="cw-tags">
              {sceneWarnings?.additional?.map(w => (
                <span class="cw-tag">{getWarningLabel(w)}</span>
              ))}
            </div>
            {sceneWarnings?.custom?.length > 0 && (
              <ul class="cw-custom-list">
                {sceneWarnings.custom.map(w => <li>{w}</li>)}
              </ul>
            )}
          </Fragment>
        ) : (
          <p class="cw-none">No additional warnings for this scene.</p>
        )}
      </div>
    </div>
  </div>
)}

  {hasAnyWarnings && !isScenePage && (
    <div class="story-block story-block--warnings">
      <StoryWarningsBlock storyWarnings={storyWarnings} />
    </div>
  )}

<style>
  .cw-wrapper {
    margin: 0.5rem 0 0.75rem 0;
    font-size: 0.875rem;
  }

  .cw-toggle {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-link);
    cursor: pointer;
    font-size: 0.875rem;
    font-family: inherit;
  }

  .cw-toggle:hover {
    text-decoration: underline;
  }

  .cw-content {
    margin-top: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-meta-bg, #f5f5f5);
    border-left: 3px solid var(--color-warning-border, #c97d00);
    border-radius: 2px;
  }

  .cw-content--static {
    margin-top: 0;
  }

  .cw-scene {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-warning-border, #c97d00);
  }

  .cw-section-label {
    display: block;
    font-weight: bold;
    font-size: 0.8rem;
    margin-bottom: 0.35rem;
    color: var(--color-meta-text, #555);
  }

  .cw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .cw-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: var(--color-warning-bg, #fff3cd);
    border: 1px solid var(--color-warning-border, #c97d00);
    border-radius: 3px;
    font-size: 0.8rem;
    text-transform: capitalize;
  }

  .cw-custom-list {
    margin: 0.4rem 0 0 0;
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-meta-text, #555);
    font-size: 0.8rem;
  }

  .cw-custom-list li {
    margin-bottom: 0.2rem;
  }

  .cw-none {
    font-style: italic;
    color: var(--color-meta-text, #555);
    font-size: 0.8rem;
    margin: 0.25rem 0 0 0;
  }
</style>