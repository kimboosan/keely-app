---
// The story's navigation (scene pages). `hierarchy` is the story as it sits
// on disk, in reading order: arcs, chapters and loose scenes, nested and in
// any order (D-158) — rendered recursively, with the same markup and
// classes at every level so reader.js and reader.css keep working.
const { hierarchy, currentSceneId, storySlug, projectSlug, nested = false } = Astro.props;
const sceneSlug = (scene) => scene.id.split('/').pop();
const href = (scene) => `/${projectSlug}/stories/${storySlug}/scenes/${sceneSlug(scene)}`;
---

{nested ? (
  hierarchy.map((node) => {
    if (node.type === 'arc') {
      return (
        <div class="nav-arc">
          <div class="nav-arc-label">{node.label}</div>
          <Astro.self hierarchy={node.children} currentSceneId={currentSceneId} storySlug={storySlug} projectSlug={projectSlug} nested />
        </div>
      );
    }
    if (node.type === 'chapter') {
      return (
        <div class="nav-chapter">
          <div class="nav-chapter-label">{node.label}</div>
          <ul class="nav-scene-list">
            {node.children.map(({ scene, sceneNumber }) => (
              <li class={sceneSlug(scene) === currentSceneId ? 'current' : ''}>
                <a href={href(scene)}>{sceneNumber}. {scene.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      );
    }
    return (
      <ul class="nav-scene-list">
        <li class={sceneSlug(node.scene) === currentSceneId ? 'current' : ''}>
          <a href={href(node.scene)}>{node.sceneNumber}. {node.scene.data.title}</a>
        </li>
      </ul>
    );
  })
) : (
  <div id="nav-panel" style="display:none;">
    <h3>Story Navigation</h3>
    <Astro.self hierarchy={hierarchy} currentSceneId={currentSceneId} storySlug={storySlug} projectSlug={projectSlug} nested />
  </div>
)}
<style>
  #nav-panel h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; margin-bottom: 0.75rem; }
  #nav-panel .nav-arc { margin-bottom: 1rem; }
  #nav-panel .nav-arc-label { font-weight: bold; font-size: 0.95rem; margin-bottom: 0.4rem; }
  #nav-panel .nav-chapter { margin-left: 0.75rem; margin-bottom: 0.5rem; }
  #nav-panel .nav-chapter-label { font-size: 0.85rem; color: #555; margin-bottom: 0.3rem; }
  #nav-panel .nav-scene-list { list-style: none; margin-left: 0.75rem; }
  #nav-panel .nav-scene-list li { margin-bottom: 0.2rem; }
  #nav-panel .nav-scene-list a { font-size: 0.9rem; color: #333; text-decoration: none; }
  #nav-panel .nav-scene-list a:hover { text-decoration: underline; }
  #nav-panel .nav-scene-list li.current a { font-weight: bold; color: #1a1a2e; }
</style>