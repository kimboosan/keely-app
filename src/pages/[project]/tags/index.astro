---
import { wikiCrumbs } from '../../../utils/crumbs.js';
import { url } from '../../../utils/url.js';
import { getProjects, getProjectConfig } from '../../../utils/config.js';
import { projectTags } from '../../../utils/projectTags.js';
import SiteLayout from '../../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = getProjects();
  return projects.map(project => ({
    params: { project: project.slug },
    props: { projectSlug: project.slug },
  }));
}

const { project } = Astro.params;
const projectConfig = await getProjectConfig(project);
const sortedTags = await projectTags(project);
---

<SiteLayout
  title={`Tags — ${projectConfig.title}`}
  crumbs={wikiCrumbs(project)}
>
  <main class="tags-index">
    <h1>Tags</h1>

    {sortedTags.length === 0 && (
      <p>No tags yet.</p>
    )}

    <ul class="tags-list">
      {sortedTags.map(([slug, label]) => (
        <li>
          <a href={url(`/${project}/tags/${slug}`)}>{label}</a>
        </li>
      ))}
    </ul>
  </main>
</SiteLayout>
