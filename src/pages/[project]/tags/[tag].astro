---
import { entrySlug } from '../../../utils/entries.mjs';
import { getProjects, getProjectConfig, slugify } from '../../../utils/config.js';
import { projectEntityTypes } from '../../../utils/projectEntities.js';
import SiteLayout from '../../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = getProjects();
  const paths = [];

  for (const project of projects) {
    // Every entity type, built-in and custom (D-086), with the project's entries.
    const entityTypes = await projectEntityTypes(project.slug);
    const allEntities = entityTypes.flatMap(t => t.entries);

    const tagMap = new Map();
    for (const entity of allEntities) {
      for (const tag of entity.data.tags ?? []) {
        const slug = slugify(tag);
        if (!tagMap.has(slug)) tagMap.set(slug, tag);
      }
    }

    for (const [tagSlug, tagLabel] of tagMap) {
      paths.push({
        params: { project: project.slug, tag: tagSlug },
        props: { tagLabel, entityTypes, projectSlug: project.slug },
      });
    }
  }

  return paths;
}

const { project } = Astro.params;
const { tagLabel, entityTypes, projectSlug } = Astro.props;
const projectConfig = await getProjectConfig(project);

const hasTag = e => (e.data.tags ?? []).some(t => slugify(t) === Astro.params.tag);
const sections = entityTypes
  .map(t => ({ ...t, tagged: t.entries.filter(hasTag) }))
  .filter(t => t.tagged.length > 0);
---

<SiteLayout
  title={`${tagLabel} — ${projectConfig.title}`}
  backLink={`/${project}/tags`}
  backLabel="Tags"
>
  <main class="tag-page">
    <h1>{tagLabel}</h1>

    {sections.map(t => (
      <section class="tag-section">
        <h2>{t.plural}</h2>
        <ul>
          {t.tagged.map(e => (
            <li><a href={`/${project}/${t.name}/${entrySlug(e)}`}>{e.data.name}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</SiteLayout>