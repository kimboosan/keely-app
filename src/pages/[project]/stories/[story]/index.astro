---
import { projectCrumbs } from '../../../../utils/crumbs.js';
import { url } from '../../../../utils/url.js';
import { findImage } from '../../../../utils/findImage.js';
import { storyReading } from '../../../../utils/storyReading.js';
import { Image } from 'astro:assets';
import { getStoryConfig, getProjectConfig, getProjects, getStoriesForProject, formatDate } from '../../../../utils/config.js';
import ContentWarnings from '../../../../components/ContentWarnings.astro';
import TagList from '../../../../components/TagList.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import NavPanel from '../../../../components/NavPanel.astro';

export async function getStaticPaths() {
  const projects = getProjects();
  const paths = [];
  for (const project of projects) {
    const stories = getStoriesForProject(project.slug);
    for (const story of stories) {
      paths.push({
        params: { project: project.slug, story: story.slug }
      });
    }
  }
  return paths;
}

const { project, story: storySlug } = Astro.params;
const story = getStoryConfig(project, storySlug);
const statusClass = `meta-status--${story.completion_status ?? 'unknown'}`;
const projectConfig = getProjectConfig(project);

// The story in reading order (D-170): Start Reading goes to its first page,
// an arc's or chapter's when it opens with one, and the side panel shows
// the navigation.
const { hierarchy, sequence } = await storyReading(project, storySlug);
const first = sequence[0] ?? null;
const startHref = first
  ? first.type === 'scene' ? url(`/${project}/stories/${storySlug}/scenes/${first.slug}`) : first.href
  : null;

const allImages = import.meta.glob('@vault/content/projects/*/stories/*/*.{jpg,png,webp,gif,svg}', { eager: true });
const storyBanner = story.banner
  ? findImage(allImages, `content/projects/${project}/stories/${storySlug}/${story.banner}`)
  : null;

const formatDate = (raw) => {
  const d = raw instanceof Date
    ? new Date(raw.getUTCFullYear(), raw.getUTCMonth(), raw.getUTCDate())
    : (() => {
        const [y, m, day] = raw.split('-').map(Number);
        return new Date(y, m - 1, day);
      })();
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<BaseLayout
  title={story.title}
  projectSlug={project}
  storySlug={storySlug}
  crumbs={projectCrumbs(project)}
  sidebarCollapsed={story.reader_defaults?.sidebar_collapsed ?? false}
>
  <Fragment slot="prose">
  <div class="story-landing">

    {storyBanner && (
      <div class="story-banner">
        <Image
          src={storyBanner}
          alt={`${story.title} cover`}
          width={1200}
          height={400}
        />
      </div>
    )}

    <h1>{story.title}</h1>
    {story.tagline && <p class="story-tagline">{story.tagline}</p>}
    {story.subtitle && <p class="story-subtitle">{story.subtitle}</p>}

    {(story.genre || story.rating) && (
      <div class="story-meta-tags">
        {story.genre && <span class="meta-genre">{story.genre}</span>}
        {story.subgenre?.map(s => (
          <span class="meta-subgenre">{s}</span>
        ))}
        {story.rating && <span class="meta-rating">{story.rating}</span>}
      </div>
    )}

    {(story.completion_status || story.start_date || story.expected_chapters) && (
      <div class="story-status">
        {story.completion_status && (
          <span class={`meta-status ${statusClass}`}>
            <strong>Status:</strong> {story.completion_status === 'in-progress' ? 'In Progress'
              : story.completion_status === 'complete' ? 'Complete'
              : story.completion_status === 'hiatus' ? 'On Hiatus'
              : 'Abandoned'}
          </span>
        )}
        {story.start_date && (
          <span class="meta-date">
            <strong>Started:</strong> {formatDate(story.start_date)}
          </span>
        )}
        {story.expected_chapters && (
          <span class="meta-chapters"><strong>Chapters:</strong> {story.expected_chapters === '?' ? 'TBD' : story.expected_chapters}</span>
        )}
      </div>
    )}

    {story.summary && (
      <div class="story-summary">
        <strong>Summary:</strong> {story.summary}
      </div>
    )}

    <TagList project={project} tags={story.tags} />

    {story.author_notes?.top && (
      <div class="story-author-note">
        <strong>Author Note:</strong> {story.author_notes.top}
      </div>
    )}

    {startHref && (
      <a href={startHref} class="story-start">Start Reading →</a>
    )}

    <ContentWarnings storyWarnings={story.content_warnings} />

    {(story.credits?.beta_readers?.length > 0 ||
      story.credits?.editors?.length > 0) && (
      <div class="story-block story-block--credits">
        <h2>Credits</h2>
        {story.credits.beta_readers?.length > 0 && (
          <p><strong>Beta readers:</strong> {story.credits.beta_readers.join(', ')}</p>
        )}
        {story.credits.editors?.length > 0 && (
          <p><strong>Editors:</strong> {story.credits.editors.join(', ')}</p>
        )}
      </div>
    )}

    {(story.acknowledgments?.dedication ||
      story.acknowledgments?.in_memoriam ||
      story.acknowledgments?.inspired_by ||
      story.acknowledgments?.thanks_to?.length > 0) && (
      <div class="story-block story-block--acknowledgments">
        <h2>Acknowledgments</h2>
        {story.acknowledgments.dedication && (
          <p><em>Dedication: {story.acknowledgments.dedication}</em></p>
        )}
        {story.acknowledgments.in_memoriam && (
          <p><em>In memoriam: {story.acknowledgments.in_memoriam}</em></p>
        )}
        {story.acknowledgments.inspired_by && (
          <p><strong>Inspired by:</strong> {story.acknowledgments.inspired_by}</p>
        )}
        {story.acknowledgments.thanks_to?.length > 0 && (
          <p><strong>Thanks to:</strong> {story.acknowledgments.thanks_to.join(', ')}</p>
        )}
      </div>
    )}

    {story.author_notes?.bottom && (
      <div class="story-author-note story-author-note--bottom">
        <strong>Author Note:</strong> {story.author_notes.bottom}
      </div>
    )}

  </div>
  </Fragment>

  <Fragment slot="wiki">
    <NavPanel hierarchy={hierarchy} storySlug={storySlug} projectSlug={project} open />
    <div id="scene-info" style="display:none;"></div>
    <div id="entity-content" style="display:none;"></div>
    <div id="wiki-nav-controls" style="display:flex; justify-content:space-between; padding:1rem 0; border-top:1px solid #ccc; margin-top:1rem;">
      <button id="back-btn" disabled>&larr; Back</button>
      <button id="forward-btn" disabled>Forward &rarr;</button>
    </div>
  </Fragment>
</BaseLayout>