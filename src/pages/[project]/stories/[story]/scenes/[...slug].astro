---
import { scenesDir } from '../../../../../utils/vault.mjs';
import { entriesIn, entrySlug } from '../../../../../utils/entries.mjs';
import { getCollection, render } from 'astro:content';
import { existsSync, readFileSync } from 'fs';
import { parse as parseToml } from 'smol-toml';
import { renderProse } from '../../../../../utils/externalLinks.mjs';
import { getStoryConfig, getProjects, getProjectConfig, getStoriesForProject, formatDate } from '../../../../../utils/config.js';
import { containerLabel, parseFolderName } from '../../../../../structure/names.mjs';
import { autoLinkShortNames, resolveWikiLinks } from '../../../../../shared/wikiLinks.mjs';
import { readEntityIndex, readOtherProject } from '../../../../../utils/projectIndex.mjs';
import { OLD_SCENE_NOTES_FIELD, sceneNotesField } from '../../../../../shared/sceneFields.mjs';
import { warnOnce } from '../../../../../utils/warnOnce.js';
import NavPanel from '../../../../../components/NavPanel.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ContentWarnings from '../../../../../components/ContentWarnings.astro';

export async function getStaticPaths() {
  const scenes = await getCollection('scenes');
  const projects = getProjects();
  const paths = [];

  const stripPrefix = (id) => id.replace(/^[^/]+\/[^/]+\/scenes\//, '');

  for (const project of projects) {
    const stories = getStoriesForProject(project.slug);
    for (const story of stories) {
      const storyConfig = getStoryConfig(project.slug, story.slug);

      const sorted = scenes
        .filter(s => s.id.startsWith(`${project.slug}/${story.slug}/`))
        .sort((a, b) => a.id < b.id ? -1 : 1);

      // The story as it sits on disk, in reading order: arcs, chapters and
      // loose scenes nested and interleaved however the author placed them
      // (D-158). Containers are recognised by their folder names (names.mjs),
      // so this follows actual depth instead of assuming one. A container's
      // _meta.toml title, when it has one, names it — as in the app.
      const hierarchy = [];
      const containers = new Map();
      for (const [index, scene] of sorted.entries()) {
        const parts = stripPrefix(scene.id).split('/');
        let siblings = hierarchy;
        let path = '';
        for (const part of parts.slice(0, -1)) {
          path = path ? `${path}/${part}` : part;
          let node = containers.get(path);
          if (!node) {
            const metaPath = `${scenesDir(project.slug, story.slug)}/${path}/_meta.toml`;
            let metaTitle;
            if (existsSync(metaPath)) {
              try {
                const title = parseToml(readFileSync(metaPath, 'utf-8')).title;
                if (typeof title === 'string' && title.trim()) metaTitle = title;
              } catch {
                // Unreadable _meta.toml: the folder name gives the title.
              }
            }
            node = { type: parseFolderName(part)?.kind ?? 'chapter', slug: part, label: containerLabel(part, metaTitle), children: [] };
            containers.set(path, node);
            siblings.push(node);
          }
          siblings = node.children;
        }
        siblings.push({ type: 'scene', scene, sceneNumber: index + 1 });
      }

      sorted.forEach((scene, index) => {
        paths.push({
          params: {
            project: project.slug,
            story: story.slug,
            slug: scene.id.split('/').pop()
          },
          props: {
            scene,
            sceneNumber: index + 1,
            prevScene: index > 0 ? sorted[index - 1] : null,
            prevSceneNumber: index > 0 ? index : null,
            nextScene: index < sorted.length - 1 ? sorted[index + 1] : null,
            nextSceneNumber: index < sorted.length - 1 ? index + 2 : null,
            storySlug: story.slug,
            projectSlug: project.slug,
            hierarchy,
            storyConfig,
            sceneIndex: sorted.map((s, i) => ({
              id: s.id.split('/').pop(),
              title: s.data.title,
              number: i + 1,
              pov: s.data.pov_character ?? null,
              threads: s.data.threads ?? [],
            })),
          },
        });
      });
    }
  }

  return paths;
}

const { scene, sceneNumber, prevScene, prevSceneNumber, nextScene, nextSceneNumber, storySlug, hierarchy, storyConfig, sceneIndex } = Astro.props;
const { project } = Astro.params;

const currentSceneSlug = scene.id.split('/').pop();
const prevSlug = prevScene ? prevScene.id.split('/').pop() : null;
const nextSlug = nextScene ? nextScene.id.split('/').pop() : null;

const characters = entriesIn(await getCollection('characters'), project);
const povCharacter = scene.data.pov_character
  ? characters.find(c => entrySlug(c) === scene.data.pov_character)
  : null;
const places = entriesIn(await getCollection('places'), project);
const sceneLocation = scene.data.scene_location
  ? places.find(p => entrySlug(p) === scene.data.scene_location)
  : null;
const sceneCharacters = scene.data.characters_in_scene
  ? characters.filter(c => scene.data.characters_in_scene.includes(entrySlug(c)))
  : [];

const entityIndex = readEntityIndex(project);

const sceneFolderPrefix = scene.id.replace(/\/index\.md$/, '');

// With the project's `auto_link` on, short names link their own first
// mention in the scene (D-160) before links are resolved.
const rawBody = getProjectConfig(project).auto_link === true
  ? autoLinkShortNames(scene.body ?? '', entityIndex)
  : (scene.body ?? '');

const resolvedBody = resolveWikiLinks(rawBody, {
  project,
  entityIndex,
  otherProject: readOtherProject,
  scenes: sceneIndex,
  storySlug,
  imageBase: `/scenes/${sceneFolderPrefix}`,
});

const renderedBody = renderProse(resolvedBody);

// Author's notes: `author_notes`, or the old `authors_notes` spelling (D-162).
const notesField = sceneNotesField(scene.data);
const authorNotes = scene.data[notesField];
if (notesField === OLD_SCENE_NOTES_FIELD) {
  warnOnce(
    `⚠️  ${scene.filePath ?? scene.id}: "authors_notes" is the old spelling. It still works, but rename it to "author_notes".`,
  );
}
---

<BaseLayout 
  title={`${scene.data.title} — ${storyConfig.title}`}
  projectSlug={project}
  storySlug={storySlug}
  sidebarCollapsed={storyConfig.reader_defaults?.sidebar_collapsed ?? false}
>
  <Fragment slot="prose">
    <script is:inline define:vars={{ sceneIndex, currentSceneId: currentSceneSlug }}>
      window.__KEELY_SCENE_INDEX__ = sceneIndex;
      window.__KEELY_CURRENT_SCENE__ = currentSceneId;
    </script>
    <h1>{sceneNumber}. {scene.data.title}</h1>
    <div class="scene-meta" data-scene-id={currentSceneSlug}>
      {scene.data.summary && <p><strong>Summary:</strong> {scene.data.summary}</p>}
      {povCharacter && <p><strong>POV:</strong> <a href={`/${project}/characters/${entrySlug(povCharacter)}`} class="wiki-link" data-entity={entrySlug(povCharacter)}>{povCharacter.data.name}</a></p>}
      {sceneLocation && <p><strong>Location:</strong> <a href={`/${project}/places/${entrySlug(sceneLocation)}`} class="wiki-link" data-entity={entrySlug(sceneLocation)}>{sceneLocation.data.name}</a></p>}
      {sceneCharacters.length > 0 && <p><strong>Characters:</strong> {sceneCharacters.map((c, i) => <><a href={`/${project}/characters/${entrySlug(c)}`} class="wiki-link" data-entity={entrySlug(c)}>{c.data.name}</a>{i < sceneCharacters.length - 1 ? ', ' : ''}</>)}</p>}
      {scene.data.narrative_mode && <p><strong>Narrative mode:</strong> {scene.data.narrative_mode}</p>}
      <div class="scene-filter">
        <label for="throughline-select"><strong>Reading thread:</strong></label>
        <select id="throughline-select">
          <option value="linear">All Scenes</option>
          {[...new Set(sceneIndex.filter(s => s.pov).map(s => s.pov))].map(pov => {
            const char = characters.find(c => entrySlug(c) === pov);
            const label = char ? char.data.name : pov;
            return <option value={`pov:${pov}`}>{label}'s POV</option>;
          })}
          {[...new Set(sceneIndex.flatMap(s => s.threads))].filter(Boolean).map(thread => (
            <option value={`thread:${thread}`}>{thread}</option>
          ))}
        </select>
      </div>
      {scene.data.word_count && (
          <p><strong>Word count:</strong> {scene.data.word_count.toLocaleString()}</p>
        )}
      {scene.data.first_published_date && (
        <p><strong>First published:</strong> {formatDate(scene.data.first_published_date)}</p>
      )}
      {scene.data.last_published_date && (
        <p><strong>Last updated:</strong> {formatDate(scene.data.last_published_date)}</p>
      )}
    </div>


    {authorNotes?.top && (
      <aside class="scene-authors-note">
        <strong>Author Note:</strong> <em>{authorNotes.top}</em>
      </aside>
    )}

    <ContentWarnings 
      storyWarnings={storyConfig.content_warnings} 
      sceneWarnings={scene.data.content_warnings}
      isScenePage={true}
    />
    
    <hr />

    <div class="scene-prose">
      <Fragment set:html={renderedBody} />

    {authorNotes?.bottom && (
      <aside class="scene-authors-note scene-authors-note--bottom">
        <strong>Author Note:</strong> <em>{authorNotes.bottom}</em>
      </aside>
      )}
    </div>

    <nav 
      style="display: flex; justify-content: space-between; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #ccc;"
      data-completion-status={storyConfig.completion_status}>
      {prevScene
        ? <a href={`/${project}/stories/${storySlug}/scenes/${prevSlug}`}>&larr; {prevSceneNumber}. {prevScene.data.title}</a>
        : <a href={`/${project}/stories/${storySlug}`}>&larr; Story Home</a>
      }
      {(nextScene !== null && nextScene !== undefined)
        ? <a href={`/${project}/stories/${storySlug}/scenes/${nextSlug}`}>{nextSceneNumber}. {nextScene.data.title} &rarr;</a>
        : <span style="color: #999;">To be continued...</span>
      }
    </nav>
  </Fragment>

  <Fragment slot="wiki">
    <NavPanel
      hierarchy={hierarchy}
      currentSceneId={currentSceneSlug}
      prevScene={prevScene}
      prevSceneNumber={prevSceneNumber}
      nextScene={nextScene}
      nextSceneNumber={nextSceneNumber}
      storySlug={storySlug}
      projectSlug={project}
    />
    <div id="scene-info">
      <h2>Scene Info</h2>
      {povCharacter && <p><strong>POV:</strong> <a href={`/${project}/characters/${entrySlug(povCharacter)}`}>{povCharacter.data.name}</a></p>}
      {sceneLocation && <p><strong>Location:</strong> <a href={`/${project}/places/${entrySlug(sceneLocation)}`}>{sceneLocation.data.name}</a></p>}
      {sceneCharacters.length > 0 && <p><strong>Characters:</strong> {sceneCharacters.map((c, i) => <><a href={`/${project}/characters/${entrySlug(c)}`}>{c.data.name}</a>{i < sceneCharacters.length - 1 ? ', ' : ''}</>)}</p>}
      {scene.data.narrative_mode && <p><strong>Narrative mode:</strong> {scene.data.narrative_mode}</p>}
    </div>
    <div id="entity-content" style="display:none;"></div>
    <div id="wiki-nav-controls" style="display:flex; justify-content:space-between; padding:1rem 0; border-top:1px solid #ccc; margin-top:1rem;">
      <button id="back-btn" disabled>&larr; Back</button>
      <button id="forward-btn" disabled>Forward &rarr;</button>
    </div>
  </Fragment>
</BaseLayout>