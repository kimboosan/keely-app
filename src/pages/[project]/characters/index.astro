---
import { entriesIn, entrySlug } from '../../../utils/entries.mjs';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { getProjects, getProjectConfig } from '../../../utils/config.js';

export async function getStaticPaths() {
  const projects = getProjects();
  return projects.map(project => ({ params: { project: project.slug } }));
}

const { project } = Astro.params;
const projectConfig = await getProjectConfig(project);

// D-120: surname is explicit, never guessed from `name` — the previous
// last-word-is-surname heuristic broke on real content (family-name-first
// characters, and names already hand-formatted "Surname, Given"). Absent
// surname falls back to `name` as-is, no inversion attempted.
function getSortName(character) {
  const { name, surname } = character.data;
  if (surname && surname.trim()) return surname.trim().toLowerCase();
  return name.trim().toLowerCase();
}

function getDisplayName(character) {
  const { name, surname, given_names, title } = character.data;
  if (!surname || !surname.trim()) return name;
  const rest = (given_names && given_names.trim()) || name;
  return title ? `${surname}, ${title} ${rest}` : `${surname}, ${rest}`;
}

const allCharacters = entriesIn(await getCollection('characters'), project);

const sortedCharacters = [...allCharacters].sort((a, b) =>
  getSortName(a).localeCompare(getSortName(b))
);

---

<SiteLayout
  title={`Characters — ${projectConfig.title}`}
  backLink={`/${project}/wiki`}
  backLabel="Wiki"
>
  <div class="entity-index">
    <h1>Characters</h1>
    <div class="entity-grid">
      {sortedCharacters.map(character => (
        <a class="entity-card" href={`/${project}/characters/${entrySlug(character)}`}>
          <div class="entity-card-name">{getDisplayName(character)}</div>
          {character.data.occupation && (
            <div class="entity-card-sub">{character.data.occupation}</div>
          )}
        </a>
      ))}
    </div>
  </div>
</SiteLayout>