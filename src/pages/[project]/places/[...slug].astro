---
import { wikiCrumbs } from '../../../utils/crumbs.js';
import { url } from '../../../utils/url.js';
import { findImage } from '../../../utils/findImage.js';
import { getCollection } from 'astro:content';
import { renderEntityMarkdown } from '../../../utils/markdown.mjs';
import { readRelationships } from '../../../utils/projectIndex.mjs';
import { entriesIn, entrySlug } from '../../../utils/entries.mjs';
import { Image } from 'astro:assets';
import { getProjects, getProjectConfig } from '../../../utils/config.js';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { slugify } from '../../../utils/config.js';
import SceneList from '../../../components/SceneList.astro';

export async function getStaticPaths() {
  const places = await getCollection('places');
  const projects = getProjects();
  const paths = [];
  for (const project of projects) {
    // Only under the entity's own project (D-159).
    entriesIn(places, project.slug).forEach(place => {
      paths.push({
        params: { project: project.slug, slug: entrySlug(place) },
        props: { place },
      });
    });
  }
  return paths;
}

const { project, slug } = Astro.params;
const { place } = Astro.props;
const bodyHtml = await renderEntityMarkdown(place.body, project);
const projectConfig = await getProjectConfig(project);

const relationships = readRelationships(project);
const scenesAtLocation = relationships.locationScenes[slug] || [];
const mentionedIn = relationships.mentionedIn[slug] || [];
const mentionedInOnly = mentionedIn.filter(
  m => !scenesAtLocation.some(a => a.slug === m.slug && a.storySlug === m.storySlug)
);
const allImages = import.meta.glob('@vault/content/projects/*/places/*/*.{jpg,png,webp,gif,svg}', { eager: true });
const placeImage = place.data.image
  ? findImage(allImages, `content/projects/${project}/places/${slug}/${place.data.image}`)
  : null;

---

<SiteLayout
  title={`${place.data.name} — ${projectConfig.title}`}
  crumbs={[...wikiCrumbs(project), { href: `/${project}/places`, label: 'Places' }]}
>
  <main class="entity-page">
    <h1>{place.data.name}</h1>

    <div class="entity-meta">
      {place.data.subtype && (
        <p><strong>Type:</strong> {place.data.subtype}</p>
      )}
      {place.data.function && (
        <p><strong>Function:</strong> {place.data.function}</p>
      )}
      {place.data.scope && (
        <p><strong>Scope:</strong> {place.data.scope}</p>
      )}
      {place.data.status && (
        <p><strong>Status:</strong> {place.data.status}</p>
      )}
      {place.data.location && (
        <p><strong>Location:</strong> {place.data.location}</p>
      )}
      {place.data.aliases && place.data.aliases.length > 0 && (
        <p><strong>Also known as:</strong> {place.data.aliases.join(', ')}</p>
      )}
    </div>

    {placeImage && (
      <div class="entity-portrait">
        <Image
          src={placeImage}
          alt={place.data.image_alt ?? ''}
          width={600}
          height={400}
        />
      </div>
    )}

    <div class="entity-prose">
      <Fragment set:html={bodyHtml} />
    </div>

    <SceneList project={project} heading="Scenes at This Location" scenes={scenesAtLocation} />

    <SceneList project={project} heading="Mentioned In" scenes={mentionedInOnly} />

    {place.data.tags && place.data.tags.length > 0 && (
      <div class="entity-tags">
        <h2>Tags</h2>
        <ul>
          {place.data.tags.map(tag => (
            <li class="tag">
              <a href={url(`/${project}/tags/${slugify(tag)}`)}>{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

  </main>
</SiteLayout>