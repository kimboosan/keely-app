---
import { findImage } from '../../../utils/findImage.js';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import { getProjectConfig, getPublisherConfig, getProjects, getStoriesForProject, formatDate } from '../../../utils/config.js';
import StoryWarningsBlock from '../../../components/StoryWarningsBlock.astro';

export async function getStaticPaths() {
  const projects = getProjects();
  return projects.map(project => ({
    params: { project: project.slug }
  }));
}

const { project: projectSlug } = Astro.params;
const project = getProjectConfig(projectSlug);
const publisher = getPublisherConfig();
const stories = getStoriesForProject(projectSlug);

const allImages = import.meta.glob(['@vault/content/projects/*/*.{jpg,png,webp,gif,svg}', '@vault/content/projects/*/images/*.{jpg,png,webp,gif,svg}'], { eager: true });
const coverImage = project.cover
  ? findImage(allImages, `content/projects/${projectSlug}/${project.cover}`)
  : null;
const bannerImage = project.banner
  ? findImage(allImages, `content/projects/${projectSlug}/${project.banner}`)
  : null;
---

<SiteLayout
  title={project.title}
  backLink="/projects"
  backLabel="Projects"
>
  {bannerImage && (
    <div class="project-banner">
      <Image
        src={bannerImage}
        alt={`${project.title} banner`}
        width={1200}
        height={400}
      />
    </div>
  )}

  <div class="project-landing">
    <h1>{project.title}</h1>
      {project.tagline && <p class="project-tagline">{project.tagline}</p>}

      {(project.genre || project.rating) && (
        <div class="story-meta-tags">
          {project.genre && <span class="meta-genre">{project.genre}</span>}
          {project.subgenre?.map(s => (
            <span class="meta-subgenre">{s}</span>
          ))}
          {project.rating && <span class="meta-rating">{project.rating}</span>}
        </div>
      )}

        {(project.created || project.updated || stories.length > 0) && (
        <div class="story-status">
          {project.created && (
            <span class="meta-date"><strong>Created:</strong> {formatDate(project.created)}</span>
          )}
          {project.updated && (
            <span class="meta-date"><strong>Updated:</strong> {formatDate(project.updated)}</span>
          )}
          <span class="meta-chapters"><strong>Stories:</strong> {stories.length}</span>
        </div>
      )}

      {(project.content_warnings?.additional?.length > 0 ||
        project.content_warnings?.custom?.length > 0 ||
        (project.content_warnings?.required && project.content_warnings.required !== 'no-warnings-apply')) ? (
        <div class="story-block story-block--warnings">
          <StoryWarningsBlock storyWarnings={project.content_warnings} />
        </div>
      ) : (
        <div class="story-block story-block--warnings">
          <h2>Content Warnings</h2>
          <p>No project-wide warnings set. Check individual stories for specific content warnings.</p>
        </div>
      )}

      {project.summary && <p class="project-summary">{project.summary}</p>}
    <p class="project-author">By <a href={project.author.url}>{project.author.name}</a></p>

    {project.author_notes?.top && (
      <div class="project-author-note">
        {project.author_notes.top}
      </div>
    )}

    <div class="project-stories">
      <h2>Stories</h2>
      {stories.map(story => (
        <p>
          <a href={`/${projectSlug}/stories/${story.slug}`}>{story.title}</a>
          {story.tagline && <span class="project-story-tagline"> — {story.tagline}</span>}
        </p>
      ))}
    </div>

    {project.author_notes?.bottom && (
      <div class="project-author-note project-author-note--bottom">
        {project.author_notes.bottom}
      </div>
    )}

  </div>
</SiteLayout>